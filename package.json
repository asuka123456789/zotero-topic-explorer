{
  "name": "zotero-topic-explorer",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "description": "Zotero 选题探索：有证据的多 Agent 选题工作台",
  "license": "MIT",
  "author": "Zotero Topic Explorer contributors",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/asuka123456789/zotero-topic-explorer.git"
  },
  "homepage": "https://github.com/asuka123456789/zotero-topic-explorer",
  "bugs": {
    "url": "https://github.com/asuka123456789/zotero-topic-explorer/issues"
  },
  "config": {
    "addonName": "Zotero Topic Explorer",
    "addonID": "{7acb66ab-18dd-4dc8-97b2-a018910aee49}",
    "addonRef": "zotero-topic-explorer",
    "addonInstance": "TopicExplorer",
    "prefsPrefix": "extensions.zotero.zotero-topic-explorer"
  },
  "scripts": {
    "build": "zotero-plugin build && tsc --noEmit -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "typecheck:test": "tsc --noEmit -p tsconfig.test.json",
    "test:unit": "mocha",
    "test:integration": "node scripts/test-isolated.mjs",
    "lint:check": "prettier --check . && eslint .",
    "lint:fix": "prettier --write . && eslint . --fix"
  },
  "dependencies": {
    "zotero-plugin-toolkit": "5.1.2"
  },
  "devDependencies": {
    "@types/chai": "^5.2.2",
    "@types/mocha": "^10.0.10",
    "@types/node": "^24.2.0",
    "@zotero-plugin/eslint-config": "^0.6.7",
    "chai": "^5.2.1",
    "eslint": "^9.32.0",
    "mocha": "12.0.2",
    "prettier": "^3.6.2",
    "typescript": "^5.9.2",
    "zotero-plugin-scaffold": "0.9.2",
    "zotero-types": "^4.1.2"
  },
  "prettier": {
    "printWidth": 88,
    "tabWidth": 2,
    "endOfLine": "lf",
    "overrides": [
      {
        "files": [
          "*.xhtml"
        ],
        "options": {
          "htmlWhitespaceSensitivity": "css"
        }
      }
    ]
  }
}
